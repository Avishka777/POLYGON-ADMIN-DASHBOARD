# Optional default database connection configurations
# You can also configure connections directly through the UI modal

# PostgreSQL example:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=your_database
# DB_SSL=false
# Or:
# DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# MySQL example:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=your_database
